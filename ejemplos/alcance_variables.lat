global i=0
poner("i global: " .. i)    #0
si i==0
    i = 5
    mientras i < 10
        poner("i dentro de mientras: " .. i)    #5-9
        i++
    fin
    poner("i despues de mientras: " .. i)    #10
    desde(i=0;i<3;i++)
        poner("i dentro de desde: " .. i)    #0-2
    fin
    poner("i despues de desde: " .. i)    #3
    global i = 2
sino
    i = 3
    poner("i dentro del sino: " .. i)    #3
fin

poner("i global: " .. i)    #2

funcion algo (a)
  #contexto local a la funcion
  a=15
  poner("local a dentro de la funcion:" .. a) #15
  retorno 10
fin

#contexto global
a=20
poner("global a:" .. a) #20
global x=algo(a)

global funcion cuadrado(y)
  poner("global dentro de funcion cuadrado x : " .. x)
  a = 13     #se cambia variable global a
  retorno y*y
fin

poner("global a:" .. a) #20
poner("global x:" .. x) #10
poner("cuadrado de a:" .. cuadrado(a)) #400
poner("global a:" .. a) #13

#salida: i global: 0 i dentro de mientras: 5 i dentro de mientras: 6 i dentro de mientras: 7 i dentro de mientras: 8 i dentro de mientras: 9 i despues de mientras: 10 i dentro de desde: 0 i dentro de desde: 1 i dentro de desde: 2 i despues de desde: 3 i global: 2 global a:20 local a dentro de la funcion:15 global a:20 global x:10 global dentro de funcion cuadrado x : 10 cuadrado de a:400 global a:20
