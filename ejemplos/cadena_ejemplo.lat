# Ejemplo de la librería cadena — Fase 10
# Ampliado con paridad al módulo "string" de Python.

incluir "cadena"

escribir("--- Constantes de 'string' ---")
escribir("Letras ASCII: " .. cadena.ascii_letras())
escribir("Minusculas: " .. cadena.ascii_minusculas())
escribir("Mayusculas: " .. cadena.ascii_mayusculas())
escribir("Digitos: " .. cadena.digitos())
escribir("Digitos Hexadecimales: " .. cadena.digitos_hex())
escribir("Digitos Octales: " .. cadena.digitos_oct())
escribir("Puntuacion: " .. cadena.puntuacion())
escribir("Imprimibles: " .. cadena.imprimibles())
escribir("Espacios en blanco: " .. cadena.espacios_blancos())

escribir("")
escribir("--- Utilidades de 'string' ---")
texto_sucio = "hola mundo desde python"
escribir("capwords: " .. cadena.palabras_capital(texto_sucio))

plantilla = "Hola $nombre, bienvenido a $lugar."
valores = {"nombre": "Carlos", "lugar": "Madrid"}
escribir("Template: " .. cadena.plantilla_sustituir(plantilla, valores))

valores_parciales = {"nombre": "Carlos"}
escribir("Safe Substitute: " .. cadena.plantilla_sustituir_seguro(plantilla, valores_parciales))

escribir("Formatter custom: " .. cadena.formatear("Valor: {}, {}", [10, 20]))

escribir("")
escribir("--- Metodos nativos de str ---")
s = "  Hola Mundo 123  "

escribir("lower(): " .. cadena.minusculas(s))
escribir("upper(): " .. cadena.mayusculas(s))
escribir("strip(): " .. cadena.recortar(s))
escribir("replace(): " .. cadena.reemplazar(s, "123", "Python"))

partes = cadena.separar(cadena.recortar(s), " ")
escribir("split(): [" .. partes[0] .. ", " .. partes[1] .. ", " .. partes[2] .. "]")

escribir("find(): " .. cadena.encontrar(s, "Mundo"))
escribir("count(): " .. cadena.contar(s, "o"))
escribir("startswith(): " .. cadena.inicia_con(cadena.recortar(s), "Hola"))
escribir("isdigit(): " .. cadena.es_numerico("12345"))

lista_palabras = ["Python", "es", "genial"]
escribir("join(): " .. lista.separador(lista_palabras, " "))

#salida:
#--- Constantes de 'string' ---
#Letras ASCII: abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ
#Minusculas: abcdefghijklmnopqrstuvwxyz
#Mayusculas: ABCDEFGHIJKLMNOPQRSTUVWXYZ
#Digitos: 0123456789
#Digitos Hexadecimales: 0123456789abcdefABCDEF
#Digitos Octales: 01234567
#Puntuacion: !"#$%&'()*+,-./:;<=>?@[\]^_`{|}~
#Imprimibles: 0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ!"#$%&'()*+,-./:;<=>?@[\]^_`{|}~
#Espacios en blanco:
#
#--- Utilidades de 'string' ---
#capwords: Hola Mundo Desde Python
#Template: Hola Carlos, bienvenido a Madrid.
#Safe Substitute: Hola Carlos, bienvenido a $lugar.
#Formatter custom: Valor: 10, 20
